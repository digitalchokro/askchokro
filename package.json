{
  "name": "askchokro",
  "private": true,
  "description": "The open-source AI Data Engine for Node.js — secure, provider-agnostic natural-language interfaces for SQL databases.",
  "license": "MIT",
  "author": "Digital Chokro <hello@digitalchokro.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalchokro/askchokro.git"
  },
  "homepage": "https://github.com/digitalchokro/askchokro",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "5.9.3",
    "vite": "^8.1.6"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "build:wp": "./scripts/build-wp-release.sh",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:eval": "eslint eval/",
    "typecheck": "turbo run typecheck",
    "typecheck:eval": "tsc -p eval --noEmit",
    "test": "turbo run test",
    "test:security": "vitest run packages/core/src/__tests__/security/ packages/core/src/__tests__/pipeline/tenant-rewriter.test.ts",
    "eval": "tsx eval/runner.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "keywords": [
    "askchokro",
    "sql",
    "ai",
    "llm",
    "text-to-sql",
    "nlp",
    "rag",
    "database",
    "analytics",
    "business intelligence",
    "agent",
    "generative ai",
    "typescript",
    "node.js"
  ],
