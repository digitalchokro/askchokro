{
  "name": "askchokro",
  "private": true,
  "description": "The open-source AI Data Engine for Node.js — secure, provider-agnostic natural-language interfaces for SQL databases.",
  "license": "MIT",
  "author": "Digital Chokro <hello@digitalchokro.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalchokro/askchokro.git"
  },
  "homepage": "https://github.com/digitalchokro/askchokro",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/minimatch": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "turbo": "^2.10.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:eval": "eslint eval/",
    "typecheck": "turbo run typecheck",
    "typecheck:eval": "tsc -p eval --noEmit",
    "test": "turbo run test",
    "test:security": "vitest run packages/core/src/__tests__/security/ packages/core/src/__tests__/pipeline/tenant-rewriter.test.ts",
    "eval": "tsx eval/runner.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "keywords": [
    "askchokro",
    "sql",
    "ai",
    "llm",
    "text-to-sql",
    "nlp",
    "rag",
    "database",
    "analytics",
    "business intelligence",
    "agent",
    "generative ai",
    "typescript",
    "node.js"
  ],
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "cross-spawn": ">=7.0.6",
      "vite": ">=6.4.3",
      "esbuild": ">=0.28.1",
      "vitest": ">=4.1.11 <5",
      "adm-zip": ">=0.6.1",
      "axios": ">=1.20.0",
      "baseline-browser-mapping": ">=2.11.0",
      "basic-ftp": ">=6.2.1",
      "body-parser": ">=1.20.6",
      "browserslist": ">=4.28.7",
      "colord": ">=2.9.4",
      "cookie": ">=0.7.0",
      "fast-uri": ">=4.1.5",
      "fastify": ">=5.12.5",
      "find-my-way": ">=9.7.0",
      "hono": ">=4.13.7",
      "ip-address": ">=10.7.1",
      "joi": ">=17.13.7",
      "js-yaml@3": ">=3.15.2 <4",
      "js-yaml@4": ">=4.3.2 <5",
      "linkify-it": ">=5.0.2",
      "markdown-it": ">=14.3.1",
      "mysql2": ">=3.23.1",
      "nanoid": ">=3.3.18",
      "next": ">=16.3.6",
      "postcss": ">=8.5.23",
      "protobufjs": ">=7.6.5",
      "qs": ">=6.16.0",
      "serialize-javascript": ">=7.0.5",
      "sharp": ">=0.35.4",
      "svgo": ">=3.3.5",
      "tar-fs@2": ">=2.1.4 <3",
